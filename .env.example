# Opcional. Só copie se quiser mudar algo: cp .env.example .env (o .env não vai pro git)

# Grupo alvo: nome aproximado (ignora acento, maiúsculas e ordem das palavras) ou id 1234@g.us
GRUPO=Meu Grupo

# 1 = headless (padrão). 0 = abre a janela do Chrome, útil para escanear o QR na tela.
# shell = usa o chrome-headless-shell (mais leve, sem janela); veja CHROME_PATH
HEADLESS=1

# Perfil do Chrome — é onde fica a sessão do WhatsApp. Padrão: ./.wwebjs_auth/session
# Use outro para não mexer na sessão que o CLI já usa
# PERFIL=./.wwebjs_auth/session

# Navegador. Vazio = acha sozinho o Chrome, Edge, Brave ou Chromium instalado
# CHROME_PATH=/usr/bin/google-chrome

# Pasta de saída dos arquivos gerados
SAIDA=./saida

# Caminhos individuais (opcionais, sobrepõem SAIDA)
# JSON=./saida/membros_ic.json
# CSV=./saida/membros_ic.csv
# XLSX=./saida/membros_ic.xlsx

# Modos alternativos
# LISTAR=1      só lista os grupos/comunidades e sai
# DIAG=1        imprime diagnóstico da leitura
# SEM_XLSX=1    gera só JSON e CSV

# Interface local no navegador (npm start) — escuta só em 127.0.0.1
PORTA=4173

# 0 = não abre o navegador do sistema sozinho ao subir a interface
# ABRIR_NAVEGADOR=0

# Flags extras para o Chrome (necessário dentro de sandbox/container)
# CHROME_ARGS=--no-sandbox --disable-setuid-sandbox --disable-dev-shm-usage --disable-gpu
