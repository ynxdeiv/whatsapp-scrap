# Copie para .env (o .env não vai pro git): cp .env.example .env

# Grupo alvo: nome aproximado (ignora acento, maiúsculas e ordem das palavras) ou id 1234@g.us
GRUPO=Meu Grupo

# 1 = headless (padrão). 0 = abre a janela do Chrome, útil para escanear o QR na tela
HEADLESS=1

# Pasta de saída dos arquivos gerados
SAIDA=./saida

# Caminhos individuais (opcionais, sobrepõem SAIDA)
# JSON=./saida/membros_ic.json
# CSV=./saida/membros_ic.csv
# XLSX=./saida/membros_ic.xlsx

# Modos alternativos
# LISTAR=1      só lista os grupos/comunidades e sai
# DIAG=1        imprime diagnóstico da leitura
# SEM_XLSX=1    gera só JSON e CSV

# Flags extras para o Chrome (necessário dentro de sandbox/container)
# CHROME_ARGS=--no-sandbox --disable-setuid-sandbox --disable-dev-shm-usage --disable-gpu
